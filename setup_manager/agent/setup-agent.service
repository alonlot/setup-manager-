[Unit]
Description=Setup Manager agent (USB/IP, status, remote shell)
After=network-online.target setup-usbipd.service
Wants=network-online.target
# No Wants=setup-usbipd.service: the agent starts it itself (ensure_usbipd) when usbipd is not
# running, so a distro usbipd.service that already holds port 3240 is not fought over.

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/setup-agent/setup_agent.py --config /etc/setup-agent/config.json
Restart=always
RestartSec=3
# Keep shells and usbipd alive when only the agent restarts.
KillMode=process

[Install]
WantedBy=multi-user.target
